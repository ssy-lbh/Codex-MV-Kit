include README.md AGENTS.md LICENSE CHANGELOG.md
recursive-include docs *.md
recursive-include prompts *.md
recursive-include examples *.md
recursive-include scripts *.py
recursive-include tests *.py
prune workspace
prune workspaces
prune private
prune artifacts
prune renders
global-exclude __pycache__ *.py[cod] *.mp4 *.wav *.zip .env
